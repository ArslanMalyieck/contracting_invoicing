{
 "doctype": "DocType", "name": "Progress Claim", "module": "Contracting Invoicing",
 "engine": "InnoDB", "is_submittable": 1,
 "naming_rule": "Expression", "autoname": "format:PC-{YYYY}-{####}",
 "title_field": "title",
 "fields": [
  {"fieldname": "title", "fieldtype": "Data", "label": "Title", "read_only": 1, "no_copy": 1},
  {"fieldname": "contract", "fieldtype": "Link", "label": "Contract", "options": "Contracting Contract", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "customer", "fieldtype": "Link", "label": "Customer", "options": "Customer", "fetch_from": "contract.customer", "read_only": 1},
  {"fieldname": "company", "fieldtype": "Link", "label": "Company", "options": "Company", "fetch_from": "contract.company", "read_only": 1},
  {"fieldname": "cb0", "fieldtype": "Column Break"},
  {"fieldname": "claim_no", "fieldtype": "Int", "label": "Claim No", "read_only": 1, "no_copy": 1,
   "description": "Sequential certificate number within the contract, assigned on submit."},
  {"fieldname": "period_from", "fieldtype": "Date", "label": "Period From", "reqd": 1},
  {"fieldname": "period_to", "fieldtype": "Date", "label": "Period To", "reqd": 1},
  {"fieldname": "posting_date", "fieldtype": "Date", "label": "Invoice Date", "reqd": 1,
   "description": "Posting date of the generated Sales Invoice."},
  {"fieldname": "sec_value", "fieldtype": "Section Break", "label": "Certified Value"},
  {"fieldname": "cumulative_certified_value", "fieldtype": "Currency", "label": "Cumulative Certified Value (Net)", "reqd": 1,
   "description": "Total certified since contract start, from the client's payment certificate. The app computes this period's value by subtracting the previous claim."},
  {"fieldname": "previous_certified_value", "fieldtype": "Currency", "label": "Previously Certified (Net)", "read_only": 1, "no_copy": 1},
  {"fieldname": "cb1", "fieldtype": "Column Break"},
  {"fieldname": "current_certified_value", "fieldtype": "Currency", "label": "This Period (Net)", "read_only": 1, "no_copy": 1},
  {"fieldname": "taxes_template", "fieldtype": "Link", "label": "Taxes Template", "options": "Sales Taxes and Charges Template", "reqd": 1},
  {"fieldname": "items", "fieldtype": "Table", "label": "Items (optional BOQ breakdown)", "options": "Progress Claim Item",
   "description": "Leave empty to invoice a single 'Value of Works Executed' line. If filled, the total must equal This Period (Net)."},
  {"fieldname": "sec_money", "fieldtype": "Section Break", "label": "Recovery, Retention and Deductions"},
  {"fieldname": "advance_recovery_gross", "fieldtype": "Currency", "label": "Advance Recovery (Gross)", "read_only": 1, "no_copy": 1,
   "description": "Computed: Recovery % x basis, capped at the remaining advance balance. Applied as ZATCA prepayment adjustment lines - never subtracted from the invoice's taxable value."},
  {"fieldname": "retention_amount", "fieldtype": "Currency", "label": "Retention", "read_only": 1, "no_copy": 1,
   "description": "Computed: Retention % x basis, capped at the contract's retention cap. VAT is charged on the full certified value; retention only reduces what is collected now."},
  {"fieldname": "cb2", "fieldtype": "Column Break"},
  {"fieldname": "deductions", "fieldtype": "Table", "label": "Deductions", "options": "Progress Claim Deduction"},
  {"fieldname": "net_amount_due", "fieldtype": "Currency", "label": "Net Amount Due", "read_only": 1, "no_copy": 1,
   "description": "What the client is expected to pay for this claim: invoice total minus advance recovery, retention and deductions. Matches the invoice's outstanding amount after submission."},
  {"fieldname": "sec_links", "fieldtype": "Section Break", "label": "Generated Documents"},
  {"fieldname": "sales_invoice", "fieldtype": "Link", "label": "Sales Invoice", "options": "Sales Invoice", "read_only": 1, "no_copy": 1},
  {"fieldname": "amended_from", "fieldtype": "Link", "label": "Amended From", "options": "Progress Claim", "read_only": 1, "no_copy": 1}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "submit": 1, "cancel": 1, "amend": 1},
  {"role": "Contracting Manager", "read": 1, "write": 1, "create": 1, "submit": 1, "cancel": 1, "amend": 1},
  {"role": "Contracting User", "read": 1, "write": 1, "create": 1, "submit": 1},
  {"role": "Accounts Manager", "read": 1},
  {"role": "Accounts User", "read": 1}
 ]
}
